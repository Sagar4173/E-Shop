{
  "version": 2,
  "buildCommand": "echo 'Skipping build - using pre-built frontend'",
  "devCommand": null,
  "outputDirectory": ".",
  "installCommand": "npm install --omit=dev",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/uploads/(.*)", "destination": "/api/uploads/[...path]" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "trailingSlash": false,
  "cleanUrls": true,
  "env": {
    "NODE_ENV": "production"
  }
}
